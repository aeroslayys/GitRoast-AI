# Set GEMINI_API_KEY as an environment variable or Cloud Run secret; never commit real keys.
GEMINI_API_KEY=
# Optional token to increase GitHub REST API rate limit.
GITHUB_TOKEN=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional backup used for transient failures.
GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite
PORT=8080

# Optional: number of X-Forwarded-For entries appended by *trusted* proxies.
# Leave unset until you verify your ingress; a wrong value permits spoofing.
# TRUSTED_PROXY_HOPS=2
